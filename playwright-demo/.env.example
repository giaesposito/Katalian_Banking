# Target environment URLs
# Copy this file to .env and fill in values before running against remote envs

# QA environment URL (used by: npm run test:qa)
QA_URL=https://qa-katalian-bank.vercel.app

# Production environment URL (used by: npm run test:prod)
PROD_URL=https://katalian-bank.vercel.app

# Local runs against http://localhost:5173 by default (no variable needed)
